Screen { layout: vertical; }
Header { height: 1; }
#filter-bar { height: 3; }
#filter-input { width: 100%; }
#body { height: 1fr; }
#apps-table { width: 1fr; height: 1fr; }
#inspector { display: none; height: 1fr; margin-left: 1; border: solid $primary; padding: 0 1; }
.with-inspector #inspector { display: block; }
#inspector-content { height: auto; }
.short Header, .short #filter-bar { display: none; }
.short #filter-bar:focus-within { display: block; }
#status-bar { height: 1; background: $panel; padding: 0 1; }
Footer { height: 1; }
ModalScreen { align: center middle; }
.text-screen { width: 90%; max-width: 100; height: 90%; border: solid $primary; background: $surface; padding: 0 1; }
#text-scroll { height: 1fr; overflow-x: hidden; }
#text-content { height: auto; }
#status-modal, #profile-modal, #confirm-modal, #edit-modal { width: 50; max-width: 100%; height: auto; max-height: 100%; border: solid $primary; background: $surface; padding: 0 1; }
ModalScreen Horizontal { height: 3; }
ModalScreen Button { min-width: 8; margin: 0; }
