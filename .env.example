# External notifications (Discord + desktop). Off by default.
# Set to "true" to enable, then restart the server/TUI/discovery processes.
# ENABLE_NOTIFICATIONS="true"

# Discord integration (also requires ENABLE_NOTIFICATIONS=true)
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/..."

# Automated job discovery (TUI [J] key, `cv-opt discover`, daily launchd agent).
# Off by default — set to "true" to enable discovery runs.
# ENABLE_DISCOVERY="true"

# If you prefer to hardcode Ollama config here:
# OLLAMA_BASE_URL="http://localhost:11434/v1"
# OLLAMA_API_KEY="ollama"
